pipeline {
    agent any

    environment {
        REGISTRY = "localhost:5001"
        IMAGE = "flask-homelab"
        TAG = "${BUILD_NUMBER}"
        NAMESPACE = "devops-homelab"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/kobyobeng/devops-homelab.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                docker build -t $REGISTRY/$IMAGE:$TAG ./app
                """
            }
        }

        stage('Push Image to Registry') {
            steps {
                sh """
                docker push $REGISTRY/$IMAGE:$TAG
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                kubectl set image deployment/flask-homelab \
                flask-homelab=$REGISTRY/$IMAGE:$TAG \
                -n $NAMESPACE
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                sh """
                kubectl rollout status deployment/flask-homelab -n $NAMESPACE
                """
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful 🚀'
        }

        failure {
            echo 'Deployment Failed ❌'
        }
    }
}
